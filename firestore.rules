rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    function isAuthenticated() {
      return request.auth != null;
    }
    function existing() {
      return resource.data;
    }
    function incoming() {
      return request.resource.data;
    }
    function isBootstrappedAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'aryasingh2366@gmail.com' ||
        request.auth.token.email == 'admin@findora.com'
      );
    }
    function isBootstrappedEditor() {
      return isAuthenticated() && (
        isBootstrappedAdmin() ||
        request.auth.token.email == 'editor@findora.com'
      );
    }
    function isAdmin() {
      return isAuthenticated() && (
        isBootstrappedAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    function isEditor() {
      return isAuthenticated() && (
        isBootstrappedEditor() ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'))
      );
    }

    // --- USERS ---
    function isValidUserCreate(data) {
      return data.keys().hasAll(['email', 'name', 'role', 'createdAt'])
        && data.email is string
        && data.name is string
        && (data.role == 'shopper' || (isBootstrappedAdmin() && data.role == 'admin') || (isBootstrappedEditor() && data.role == 'editor'))
        && data.createdAt is string
        && (!data.keys().hasAny(['avatar']) || data.avatar is string)
        && (!data.keys().hasAny(['lastLogin']) || data.lastLogin is string)
        && (!data.keys().hasAny(['id']) || data.id is string);
    }
    
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId && isValidUserCreate(incoming());
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == userId && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'email', 'createdAt', 'id']))
      );
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // --- PRODUCTS ---
    match /products/{productId} {
      allow read: if true;
      allow create: if isEditor();
      allow update: if isEditor();
      allow delete: if isAdmin();
    }

    // --- STORES ---
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isEditor();
      allow update: if isEditor();
      allow delete: if isAdmin();
    }

    // --- OFFERS ---
    match /offers/{offerId} {
      allow read: if true;
      allow create: if isEditor();
      allow update: if isEditor();
      allow delete: if isEditor();
    }

    // --- WISHLISTS ---
    match /wishlists/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // --- CLICKS ---
    match /clicks/{clickId} {
      allow create: if true;
      allow read: if isAdmin();
    }

    // --- PRICE HISTORY ---
    match /priceHistory/{docId} {
      allow read: if true;
      allow create: if isEditor();
      allow update: if isEditor();
      allow delete: if isAdmin();
    }
    
    // --- PRICE ALERTS ---
    match /priceAlerts/{docId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId && request.auth.uid == request.resource.data.userId;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }
    
    // --- LOGIN HISTORY ---
    match /securityEvents/{docId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false; // Security events are immutable
    }
    
    // --- IMPORT HISTORY ---

    // --- IMPORT HISTORY ---
    match /importHistory/{docId} {
      allow read: if isEditor();
      allow create: if isEditor();
      allow update: if isEditor();
      allow delete: if isAdmin();
    }

    // --- PRODUCT DRAFTS ---
    match /productDrafts/{draftId} {
      allow read: if isEditor();
      allow create: if isEditor();
      allow update: if isEditor();
      allow delete: if isAdmin();
    }
    
    // --- BRANDS ---
    match /brands/{brandId} {
      allow read: if true;
      allow create: if isEditor();
      allow update: if isEditor();
      allow delete: if isAdmin();
    }
    
    // --- CATEGORIES ---
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isEditor();
      allow update: if isEditor();
      allow delete: if isAdmin();
    }

    // --- AUDIT LOGS ---
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && (isEditor() || isAdmin()) && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false; // Audit logs are strictly immutable
    }

    // --- SEARCH ANALYTICS ---
    match /searchEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if incoming().keys().hasAll(['query', 'resultsCount', 'timestamp'])
        && incoming().query is string
        && incoming().query.size() <= 100
        && incoming().resultsCount is number
        && incoming().timestamp is string;
      allow update, delete: if false;
    }

    // --- REALTIME SITE EVENTS (PR #43) ---
    // One doc per page view / product view, written by any visitor through
    // the client SDK in services/realtime.ts. Shape-checked so the
    // collection can't be used as a junk store; reads are admin-only and
    // the docs are immutable (no update/delete for anyone).
    // NOTE: rules in this file only take effect after a deploy
    // (Firebase console > Firestore > Rules, or `firebase deploy
    // --only firestore:rules`). Until then the event writes fail silently
    // (by design) and the dashboard honestly shows 0.
    match /siteEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if incoming().keys().hasAll(['type', 'path', 'referrer', 'source', 'sessionId', 'ts'])
        && incoming().type is string
        && (incoming().type == 'view' || incoming().type == 'product_view')
        && incoming().path is string
        && incoming().path.size() <= 200
        && incoming().referrer is string
        && incoming().referrer.size() <= 100
        && incoming().source is string
        && incoming().source.size() <= 40
        && incoming().sessionId is string
        && incoming().sessionId.size() <= 64
        && incoming().ts is string
        && (!incoming().keys().hasAny(['utm_source']) || incoming().utm_source is string)
        && (!incoming().keys().hasAny(['productId']) || incoming().productId is string)
        && (!incoming().keys().hasAny(['productName']) || incoming().productName is string)
        && (!incoming().keys().hasAny(['category']) || incoming().category is string)
        && (incoming().type == 'view' || incoming().keys().hasAll(['productId', 'productName', 'category']));
      allow update, delete: if false;
    }

    // --- REALTIME ACTIVE SESSIONS (PR #43) ---
    // One doc per tab session, heartbeat-updated every 60s by its own
    // visitor (services/realtime.ts). The doc id MUST equal the sessionId
    // in the data, so a visitor can only ever touch their own session.
    // Reads are admin-only; deletes are forbidden (docs age out of the
    // "active now" window on lastSeen instead).
    match /activeSessions/{sessionId} {
      allow read: if isAdmin();
      allow create: if incoming().keys().hasAll(['sessionId', 'lastSeen', 'path', 'source'])
        && incoming().sessionId is string
        && incoming().sessionId == sessionId
        && incoming().lastSeen is string
        && incoming().path is string
        && incoming().path.size() <= 200
        && incoming().source is string
        && incoming().source.size() <= 40;
      allow update: if incoming().keys().hasAll(['sessionId', 'lastSeen', 'path', 'source'])
        && incoming().sessionId is string
        && incoming().sessionId == sessionId
        && incoming().lastSeen is string
        && incoming().path is string
        && incoming().path.size() <= 200
        && incoming().source is string
        && incoming().source.size() <= 40;
      allow delete: if false;
    }

    // --- NEWSLETTER SUBSCRIBERS ---
    // Public create so guests can subscribe from the footer (the write goes
    // through the client SDK in store.subscribeNewsletter). Shape-checked so
    // the collection can't be used as a junk store; reads are admin-only.
    // NOTE: rules in this file only take effect after a deploy
    // (Firebase console > Firestore > Rules, or `firebase deploy
    // --only firestore:rules`). Until then the subscribe call fails and
    // the footer says so instead of faking success.
    match /newsletterSubscribers/{docId} {
      allow read: if isAdmin();
      allow create: if incoming().keys().hasAll(['email', 'subscribedAt', 'source'])
        && incoming().keys().size() == 3
        && incoming().email is string
        && incoming().email.size() >= 5
        && incoming().email.size() <= 100
        && incoming().subscribedAt is string
        && incoming().source is string;
      allow update, delete: if isAdmin();
    }

    // --- CONTACT MESSAGES ---
    // Public create so guests can send a message from the contact page
    // (the write goes through the client SDK in store.submitContactMessage).
    // Shape-checked so the collection can't be used as a junk store;
    // reads are admin-only.
    // NOTE: rules in this file only take effect after a deploy
    // (Firebase console > Firestore > Rules, or `firebase deploy
    // --only firestore:rules`). Until then the send call fails and
    // the contact page says so instead of faking success.
    match /contactMessages/{docId} {
      allow read: if isAdmin();
      allow create: if incoming().keys().hasAll(['name', 'email', 'subject', 'message', 'createdAt', 'source'])
        && incoming().keys().size() == 6
        && incoming().name is string
        && incoming().name.size() >= 1
        && incoming().name.size() <= 100
        && incoming().email is string
        && incoming().email.size() >= 5
        && incoming().email.size() <= 100
        && incoming().subject is string
        && incoming().subject.size() >= 1
        && incoming().subject.size() <= 200
        && incoming().message is string
        && incoming().message.size() >= 1
        && incoming().message.size() <= 2000
        && incoming().createdAt is string
        && incoming().source is string;
      allow update, delete: if isAdmin();
    }
  }
}

