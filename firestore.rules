rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    function isAuthenticated() {
      return request.auth != null;
    }
    function existing() {
      return resource.data;
    }
    function incoming() {
      return request.resource.data;
    }
    function isBootstrappedAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'aryasingh2366@gmail.com' ||
        request.auth.token.email == 'admin@findora.com'
      );
    }
    function isBootstrappedEditor() {
      return isAuthenticated() && (
        isBootstrappedAdmin() ||
        request.auth.token.email == 'editor@findora.com'
      );
    }
    function isAdmin() {
      return isAuthenticated() && (
        isBootstrappedAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    function isEditor() {
      return isAuthenticated() && (
        isBootstrappedEditor() ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'))
      );
    }

    // --- USERS ---
    function isValidUserCreate(data) {
      return data.keys().hasAll(['email', 'name', 'role', 'createdAt'])
        && data.email is string
        && data.name is string
        && (data.role == 'shopper' || (isBootstrappedAdmin() && data.role == 'admin') || (isBootstrappedEditor() && data.role == 'editor'))
        && data.createdAt is string
        && (!data.keys().hasAny(['avatar']) || data.avatar is string)
        && (!data.keys().hasAny(['lastLogin']) || data.lastLogin is string)
        && (!data.keys().hasAny(['id']) || data.id is string);
    }
    
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId && isValidUserCreate(incoming());
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == userId && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'email', 'createdAt', 'id']))
      );
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // --- PRODUCTS ---
    match /products/{productId} {
      allow read: if true;
      allow create: if isEditor();
      allow update: if isEditor();
      allow delete: if isAdmin();
    }

    // --- STORES ---
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isEditor();
      allow update: if isEditor();
      allow delete: if isAdmin();
    }

    // --- OFFERS ---
    match /offers/{offerId} {
      allow read: if true;
      allow create: if isEditor();
      allow update: if isEditor();
      allow delete: if isEditor();
    }

    // --- WISHLISTS ---
    match /wishlists/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // --- CLICKS ---
    match /clicks/{clickId} {
      allow create: if true;
      allow read: if isAdmin();
    }

    // --- PRICE HISTORY ---
    match /priceHistory/{docId} {
      allow read: if true;
      allow create: if isEditor();
      allow update: if isEditor();
      allow delete: if isAdmin();
    }
    
    // --- PRICE ALERTS ---
    match /priceAlerts/{docId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId && request.auth.uid == request.resource.data.userId;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }
    
    // --- LOGIN HISTORY ---
    match /securityEvents/{docId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false; // Security events are immutable
    }
    
    // --- IMPORT HISTORY ---

    // --- IMPORT HISTORY ---
    match /importHistory/{docId} {
      allow read: if isEditor();
      allow create: if isEditor();
      allow update: if isEditor();
      allow delete: if isAdmin();
    }

    // --- PRODUCT DRAFTS ---
    match /productDrafts/{draftId} {
      allow read: if isEditor();
      allow create: if isEditor();
      allow update: if isEditor();
      allow delete: if isAdmin();
    }
    
    // --- BRANDS ---
    match /brands/{brandId} {
      allow read: if true;
      allow create: if isEditor();
      allow update: if isEditor();
      allow delete: if isAdmin();
    }
    
    // --- CATEGORIES ---
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isEditor();
      allow update: if isEditor();
      allow delete: if isAdmin();
    }

    // --- AUDIT LOGS ---
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && (isEditor() || isAdmin()) && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false; // Audit logs are strictly immutable
    }

    // --- SEARCH ANALYTICS ---
    match /searchEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if incoming().keys().hasAll(['query', 'resultsCount', 'timestamp'])
        && incoming().query is string
        && incoming().query.size() <= 100
        && incoming().resultsCount is number
        && incoming().timestamp is string;
      allow update, delete: if false;
    }
  }
}

