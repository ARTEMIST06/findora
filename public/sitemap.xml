<!-- Findora sitemap.
     The app is hash-routed (/#/products, /#/categories, ...), so crawlers
     only ever see the homepage: URL fragments are stripped from sitemap
     locs, and the clean paths would all serve the same index.html. Listing
     only the one URL Google can actually crawl.
     The previous sitemap listed findora.in (wrong domain, site is
     findora-one.vercel.app) and 12 fabricated seed products (iPhone 16 Pro,
     S25 Ultra, MacBook Air M3, ...) that were deleted from the catalogue in
     PR #9 — those entries are gone.
     The real fix is real routes (react-router) + a generated sitemap; until
     then, this file stays honest and minimal. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://findora-one.vercel.app/</loc>
    <lastmod>2026-11-15</lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
