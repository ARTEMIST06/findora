# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Analytics (Optional)
VITE_GA_MEASUREMENT_ID=
VITE_GTM_ID=
VITE_META_PIXEL_ID=

# Google Search Console Verification (Optional)
# Enter your Google Search Console verification token (from the <meta name="google-site-verification" content="..."> tag).
# When provided, Findora automatically injects the verification tag into the <head> of all pages.
VITE_GOOGLE_SITE_VERIFICATION=

# Merchant API Integration Keys
# For fetching automated product data directly from merchant services
AMAZON_CREATORS_API_CREDENTIAL_ID=
AMAZON_CREATORS_API_SECRET=
AMAZON_CREATORS_API_VERSION=
AMAZON_PARTNER_TAG=
FLIPKART_API_KEY=
CROMA_API_KEY=
